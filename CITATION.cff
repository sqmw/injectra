preferred-citation:
  type: article
  title: "Injectra: Retrofitting Extensibility into Web-Based Desktop Applications"
  authors:
    - family-names: Sun
      given-names: Qin
  journal: arXiv
  year: 2026
  doi: "10.48550/arXiv.2611.20713"
